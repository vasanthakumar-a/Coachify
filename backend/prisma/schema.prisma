generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Address {
  id        Int      @id @default(autoincrement())
  address1  String?
  address2  String?
  city      String?
  state     String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coaches   Coach[]
}

model Appointment {
  id               Int             @id @default(autoincrement())
  name             String
  from             DateTime
  to               DateTime
  duration         Float
  mode             String
  starts           DateTime
  ends             DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userId           Int
  coachId          Int
  specializationId Int?
  user             User            @relation(fields: [userId], references: [id])
  coach            Coach           @relation(fields: [coachId], references: [id])
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
}

model Certification {
  id                Int       @id @default(autoincrement())
  title             String
  description       String?
  url               String?
  validated         Boolean   @default(false)
  issuedAt          DateTime?
  expiresAt         DateTime?
  issuedBy          String?
  issuerUrl         String?
  certificationType Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  coaches           Coach[]
}

model Coach {
  id                Int              @id @default(autoincrement())
  firstName         String
  lastName          String
  username          String
  email             String           @unique
  phone             String?
  bio               String?
  gender            String?
  experienceYear    Int?
  hourlyRate        Decimal?
  paymentPlanId     Int?
  availableTimeFrom DateTime?
  availableTimeTo   DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  role              Int              @default(0)
  feedbacks         Feedback[]
  successStories    SuccessStory[]
  certifications    Certification[]
  specializationId  Int?
  addressesId       Int?
  appointments      Appointment[]
  paymentHistories  PaymentHistory[]
  paymentPlans      PaymentPlan[]
  specialization    Specialization?  @relation(fields: [specializationId], references: [id])
  address           Address?         @relation(fields: [addressesId], references: [id])
}

model Feedback {
  id           Int            @id @default(autoincrement())
  userId       Int
  coachId      Int
  rating       Int
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id])
  coach        Coach          @relation(fields: [coachId], references: [id])
  SuccessStory SuccessStory[]
}

model Notification {
  id             Int      @id @default(autoincrement())
  userId         Int
  title          String
  isAnnouncement Boolean
  sessionLink    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model PaymentHistory {
  id            Int      @id @default(autoincrement())
  userId        Int
  coachId       Int
  transactionId String
  mode          String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  coach         Coach    @relation(fields: [coachId], references: [id])
}

model PaymentPlan {
  id           Int      @id @default(autoincrement())
  coachId      Int
  title        String
  amount       Decimal
  durationFrom DateTime
  durationTo   DateTime
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  coach        Coach    @relation(fields: [coachId], references: [id])
}

model Specialization {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  coaches      Coach[]
  appointments Appointment[]
}

model SuccessStory {
  id         Int      @id @default(autoincrement())
  coachId    Int
  feedbackId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  coach      Coach    @relation(fields: [coachId], references: [id])
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
}

model User {
  id                  Int              @id @default(autoincrement())
  email               String           @unique
  googleId            String?
  refreshToken        String?
  encryptedPassword   String
  resetPasswordToken  String?          @unique
  resetPasswordSentAt DateTime?
  rememberCreatedAt   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  firstName           String?
  lastName            String?
  username            String?          @unique
  phone               String?
  location            String?
  bio                 String?
  gender              String?
  specializationId    Int?
  specialization      Specialization?  @relation(fields: [specializationId], references: [id])
  appointments        Appointment[]
  feedbacks           Feedback[]
  notifications       Notification[]
  paymentHistories    PaymentHistory[]
}
